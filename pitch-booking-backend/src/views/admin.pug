doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Quản trị Hệ thống - Sân Thể Thao
    //- Bootstrap 5 CSS
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet")
    link(href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet")
  body.bg-light
    //- Thanh điều hướng admin
    nav.navbar.navbar-expand-lg.navbar-dark.bg-dark.shadow-sm
      .container
        a.navbar-brand(href="/")
          i.fas.fa-futbol.me-2
          | Sàn Thể Thao - Admin
        .ms-auto
          a.btn.btn-outline-light.btn-sm.me-2(href="/") Về trang chủ
          button.btn.btn-danger.btn-sm(onclick="logout()") Đăng xuất

    .container.py-5
      .row.mb-4
        .col-md-8
          h2.fw-bold.text-primary
            i.fas.fa-user-shield.me-2
            | Quản trị Người dùng & Chủ sân
          p.text-muted Quản lý tài khoản khách hàng, chủ sân và phân quyền hệ thống.
        .col-md-4.text-end
          button.btn.btn-success(data-bs-toggle="modal" data-bs-target="#userModal" onclick="resetForm()")
            i.fas.fa-plus.me-2
            | Thêm tài khoản mới

      //- Bảng danh sách
      .card.shadow-sm
        .card-body
          .table-responsive
            table.table.table-hover.align-middle
              thead.table-dark
                tr
                  th Họ tên
                  th Email
                  th Số điện thoại
                  th Vai trò (Role)
                  th Ngày tạo
                  th.text-center Thao tác
              tbody#userTableBody
                //- Dữ liệu sẽ được render bằng JS qua API

    //- Modal Thêm / Sửa tài khoản
    .modal.fade#userModal(tabindex="-1")
      .modal-dialog
        .modal-content
          .modal-header
            h5.modal-title#modalTitle Thêm tài khoản mới
            button.btn-close(type="button" data-bs-dismiss="modal")
          .modal-body
            form#userForm
              input(type="hidden" id="userId")
              .mb-3
                label.form-label Họ và tên
                input.form-control(type="text" id="name" required)
              .mb-3
                label.form-label Email
                input.form-control(type="email" id="email" required)
              .mb-3#passwordGroup
                label.form-label Mật khẩu
                input.form-control(type="password" id="password" required)
              .mb-3
                label.form-label Số điện thoại
                input.form-control(type="text" id="phone" required)
              .mb-3
                label.form-label Vai trò
                select.form-select(id="role")
                  option(value="customer") Khách hàng (Customer)
                  option(value="owner") Chủ sân (Owner)
                  option(value="admin") Quản trị viên (Admin)
              button.btn.btn-primary.w-100(type="submit") Lưu thông tin

    //- Bootstrap JS Bundle
    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js")
    script.
      // 1. Kiểm tra bảo mật ngay khi tải trang
      const token = localStorage.getItem('token');
      const user = JSON.parse(localStorage.getItem('user') || '{}');

      if (!token || user.role !== 'admin') {
        alert('Bạn cần đăng nhập bằng tài khoản Quản trị viên để truy cập trang này!');
        window.location.href = '/auth';
      }

      function logout() {
        localStorage.removeItem('token');
        localStorage.removeItem('user');
        window.location.href = '/auth';
      }

      const API_URL = '/api/admin/users';

      // Load danh sách khi mở trang
      document.addEventListener('DOMContentLoaded', fetchUsers);

      async function fetchUsers() {
        try {
          const res = await fetch(API_URL, {
            headers: { 'Authorization': `Bearer ${token}` }
          });
          const result = await res.json();
          if (res.ok && result.success) {
            renderTable(result.data);
          } else {
            alert(result.error || 'Không thể tải danh sách!');
          }
        } catch (err) {
          console.error('Lỗi khi tải dữ liệu:', err);
        }
      }

      function renderTable(users) {
        const tbody = document.getElementById('userTableBody');
        tbody.innerHTML = '';
        users.forEach(user => {
          let roleBadge = user.role === 'admin' ? 'bg-danger' : user.role === 'owner' ? 'bg-warning text-dark' : 'bg-info';
          tbody.innerHTML += `
            <tr>
              <td>${user.name}</td>
              <td>${user.email}</td>
              <td>${user.phone}</td>
              <td><span class="badge ${roleBadge}">${user.role}</span></td>
              <td>${new Date(user.createdAt).toLocaleDateString('vi-VN')}</td>
              <td class="text-center">
                <button class="btn btn-sm btn-outline-warning me-2" onclick='openEditModal(${JSON.stringify(user)})'>
                  <i class="fas.fa-edit"></i>
                </button>
                <button class="btn btn-sm btn-outline-danger" onclick="deleteUser('${user._id}')">
                  <i class="fas.fa-trash"></i>
                </button>
              </td>
            </tr>
          `;
        });
      }

      function resetForm() {
        document.getElementById('modalTitle').innerText = 'Thêm tài khoản mới';
        document.getElementById('userForm').reset();
        document.getElementById('userId').value = '';
        document.getElementById('email').removeAttribute('disabled');
        document.getElementById('passwordGroup').style.display = 'block';
        document.getElementById('password').setAttribute('required', 'true');
      }

      function openEditModal(user) {
        document.getElementById('modalTitle').innerText = 'Cập nhật tài khoản';
        document.getElementById('userId').value = user._id;
        document.getElementById('name').value = user.name;
        document.getElementById('email').value = user.email;
        document.getElementById('email').setAttribute('disabled', 'true'); // Không cho sửa email khi update
        document.getElementById('phone').value = user.phone;
        document.getElementById('role').value = user.role;
        
        // Ẩn trường mật khẩu khi sửa
        document.getElementById('passwordGroup').style.display = 'none';
        document.getElementById('password').removeAttribute('required');

        const modal = new bootstrap.Modal(document.getElementById('userModal'));
        modal.show();
      }

      // Xử lý Submit Form (Thêm hoặc Sửa)
      document.getElementById('userForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const id = document.getElementById('userId').value;
        const name = document.getElementById('name').value;
        const email = document.getElementById('email').value;
        const password = document.getElementById('password').value;
        const phone = document.getElementById('phone').value;
        const role = document.getElementById('role').value;

        try {
          let response;
          if (id) {
            // Sửa
            response = await fetch(`${API_URL}/${id}`, {
              method: 'PUT',
              headers: { 
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${token}`
              },
              body: JSON.stringify({ name, phone, role })
            });
          } else {
            // Thêm mới
            response = await fetch(API_URL, {
              method: 'POST',
              headers: { 
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${token}`
              },
              body: JSON.stringify({ name, email, password, phone, role })
            });
          }

          const result = await response.json();
          if (response.ok) {
            bootstrap.Modal.getInstance(document.getElementById('userModal')).hide();
            fetchUsers();
          } else {
            alert(result.error || 'Có lỗi xảy ra!');
          }
        } catch (err) {
          console.error(err);
        }
      });

      async function deleteUser(id) {
        if (confirm('Bạn có chắc chắn muốn xóa tài khoản này không?')) {
          try {
            const res = await fetch(`${API_URL}/${id}`, { 
              method: 'DELETE',
              headers: { 'Authorization': `Bearer ${token}` }
            });
            if (res.ok) {
              fetchUsers();
            } else {
              const result = await res.json();
              alert(result.error || 'Xóa thất bại!');
            }
          } catch (err) {
            console.error(err);
          }
        }
      }