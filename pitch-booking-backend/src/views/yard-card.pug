//- src/views/components/yard-card.pug
mixin yardCard(yard)
  //- Thẻ card tổng: Cố định hoàn toàn chiều cao, dùng flex để căn đều các thành phần
  div(class="bg-white p-4 rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg hover:border-emerald-200 transition-all duration-300 flex flex-col justify-between h-full group")
    
    //- Phần thông tin phía trên
    div
      //- Khung ảnh và huy hiệu loại sân
      div(class="relative h-44 overflow-hidden rounded-xl mb-3 bg-gray-100")
        img(
          src=yard.image || yard.imageUrl || "https://images.unsplash.com/photo-1508098682722-e99c43a406b2?q=80&w=500&auto=format&fit=crop" 
          alt=yard.name || "Sân thể thao" 
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        )
        //- Huy hiệu hiển thị Loại sân
        span(class="absolute top-2.5 left-2.5 bg-emerald-600 text-white text-[10px] font-bold px-2.5 py-1 rounded-lg uppercase shadow-md")
          = yard.type || yard.sportType || yard.sport || 'Thể thao'
          
      //- Tên sân (Giới hạn 1 dòng tránh làm lệch khung)
      h4(class="font-bold text-sm text-gray-900 mb-1 line-clamp-1 group-hover:text-emerald-600 transition-colors" title=yard.name)
        = yard.name
        
      //- Địa chỉ sân
      p(class="text-gray-500 text-[11px] mb-3 flex items-center gap-1.5 line-clamp-1" title=yard.location || yard.address)
        i(class="fas fa-map-marker-alt text-emerald-500 flex-shrink-0")
        span= yard.location || yard.address || 'Đang cập nhật'

    //- Phần thông tin phía dưới: Giá tiền (Sáng / Tối) và cụm Nút bấm (Bám sát đáy nhờ mt-auto)
    div(class="pt-3 border-t border-gray-100 mt-auto")
      //- Hiển thị song song Giá sáng và Giá tối
      div(class="grid grid-cols-2 gap-2 mb-3 bg-gray-50 p-2 rounded-xl text-center")
        div
          span(class="block text-[9px] text-gray-400 font-bold uppercase") Sáng
          span(class="text-emerald-600 font-black text-xs")
            = yard.priceMorning ? yard.priceMorning.toLocaleString() + 'đ' : 'Liên hệ'
        div(class="border-l border-gray-200")
          span(class="block text-[9px] text-gray-400 font-bold uppercase") Tối
          span(class="text-amber-600 font-black text-xs")
            = yard.priceEvening ? yard.priceEvening.toLocaleString() + 'đ' : 'Liên hệ'

      //- Cụm 2 nút bấm: Xem chi tiết & Đặt sân ngay
      div(class="grid grid-cols-2 gap-1.5")
        a(href=`/booking/${yard._id || yard.id}` class="py-2 px-2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold text-[11px] rounded-xl transition-all no-underline text-center flex items-center justify-center gap-1")
          i(class="fas fa-eye text-[10px]")
          | Chi tiết
        a(href=`/booking/${yard._id || yard.id}` class="py-2 px-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-[11px] rounded-xl transition-all no-underline text-center shadow-sm flex items-center justify-center gap-1")
          i(class="fas fa-calendar-check text-[10px]")
          | Đặt sân