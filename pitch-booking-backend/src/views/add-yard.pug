doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Thêm Cơ Sở Sân Mới - SportHub
    script(src="https://cdn.tailwindcss.com")
    link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css")
  
  body(class="bg-gray-50 font-sans text-gray-800")
    main(class="max-w-3xl mx-auto px-4 py-10")
      div(class="mb-6")
        a(href="/owner" class="text-xs font-bold text-emerald-600 hover:text-emerald-700 flex items-center gap-1 mb-2")
          i(class="fas fa-arrow-left")
          | Quay lại trang quản lý
        h1(class="text-2xl font-black text-gray-900") Thêm Cụm Sân / Cơ Sở Mới

      form(id="addYardForm" onsubmit="submitYard(event)" class="space-y-6 bg-white p-6 sm:p-8 rounded-3xl border border-gray-100 shadow-sm")
        //- Thông tin chung cơ sở
        div(class="space-y-4")
          h2(class="text-sm font-black text-gray-900 uppercase tracking-wider") 1. Thông tin chung cơ sở
          
          div
            label(class="block text-xs font-bold text-gray-700 mb-1") Tên cụm sân / cơ sở
            input(type="text" name="name" required placeholder="VD: Sân bóng Đại học Nông Nghiệp" class="w-full px-4 py-2.5 text-xs border border-gray-200 rounded-xl focus:outline-none focus:border-emerald-600 font-medium")

          div(class="grid grid-cols-1 sm:grid-cols-2 gap-4")
            div
              label(class="block text-xs font-bold text-gray-700 mb-1") Loại môn thể thao
              select(name="type" class="w-full px-4 py-2.5 text-xs border border-gray-200 rounded-xl focus:outline-none focus:border-emerald-600 font-medium bg-white")
                option(value="Bóng đá") Bóng đá
                option(value="Bóng rổ") Bóng rổ
                option(value="Pickleball") Pickleball
                option(value="Cầu lông") Cầu lông
            div
              label(class="block text-xs font-bold text-gray-700 mb-1") Địa chỉ cụ thể
              input(type="text" name="location" required placeholder="VD: Trâu Quỳ, Gia Lâm, Hà Nội" class="w-full px-4 py-2.5 text-xs border border-gray-200 rounded-xl focus:outline-none focus:border-emerald-600 font-medium")

          div(class="grid grid-cols-1 sm:grid-cols-2 gap-4")
            div
              label(class="block text-xs font-bold text-gray-700 mb-1") Giá ca sáng (VNĐ / giờ)
              input(type="number" name="priceMorning" required min="0" placeholder="VD: 200000" class="w-full px-4 py-2.5 text-xs border border-gray-200 rounded-xl focus:outline-none focus:border-emerald-600 font-medium")
            div
              label(class="block text-xs font-bold text-gray-700 mb-1") Giá ca tối (VNĐ / giờ)
              input(type="number" name="priceEvening" required min="0" placeholder="VD: 350000" class="w-full px-4 py-2.5 text-xs border border-gray-200 rounded-xl focus:outline-none focus:border-emerald-600 font-medium")

          div
            label(class="block text-xs font-bold text-gray-700 mb-1") Tải lên hình ảnh sân
            input(type="file" name="image" accept="image/*" class="w-full px-4 py-2 text-xs border border-gray-200 rounded-xl bg-white font-medium file:mr-4 file:py-1.5 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-bold file:bg-emerald-50 file:text-emerald-700 hover:file:bg-emerald-100")

        hr(class="border-gray-100")

        //- Danh sách sân con
        div(class="space-y-3")
          div(class="flex items-center justify-between")
            div
              h2(class="text-sm font-black text-gray-900 uppercase tracking-wider") 2. Danh sách các sân con bên trong
              p(class="text-[11px] text-gray-500 mt-0.5") Khách hàng sẽ chọn cụ thể sân nào trong danh sách này khi đặt lịch.
            button(type="button" onclick="addSubFieldInput()" class="px-3 py-1.5 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 text-xs font-bold rounded-xl transition-all")
              i(class="fas fa-plus mr-1") Thêm sân

          div(id="subFieldsContainer" class="space-y-2.5")
            div(class="flex items-center gap-2")
              input(type="text" name="subFieldNames" required placeholder="VD: Sân số 1" class="w-full px-4 py-2 text-xs border border-gray-200 rounded-xl focus:outline-none focus:border-emerald-600 font-medium")
              button(type="button" onclick="removeSubField(this)" class="px-3 py-2 bg-rose-50 text-rose-600 hover:bg-rose-100 rounded-xl text-xs font-bold transition-all") Xóa

        button(type="submit" class="w-full py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-black text-xs uppercase tracking-wider rounded-xl transition-all shadow-md shadow-emerald-600/20") Lưu và tạo cơ sở sân

    script.
      function addSubFieldInput() {
        const container = document.getElementById('subFieldsContainer');
        const div = document.createElement('div');
        div.className = "flex items-center gap-2";
        div.innerHTML = `
          <input type="text" name="subFieldNames" required placeholder="VD: Sân tiếp theo" class="w-full px-4 py-2 text-xs border border-gray-200 rounded-xl focus:outline-none focus:border-emerald-600 font-medium">
          <button type="button" onclick="removeSubField(this)" class="px-3 py-2 bg-rose-50 text-rose-600 hover:bg-rose-100 rounded-xl text-xs font-bold transition-all">Xóa</button>
        `;
        container.appendChild(div);
      }

      function removeSubField(btn) {
        const container = document.getElementById('subFieldsContainer');
        if (container.children.length <= 1) {
          alert('Cụm sân phải có ít nhất 1 sân con!');
          return;
        }
        btn.parentElement.remove();
      }

      async function submitYard(event) {
        event.preventDefault();
        const formElement = event.target;
        const formData = new FormData(formElement); // Gửi trực tiếp FormData chứa cả file và text

        const token = localStorage.getItem('token');
        try {
          const res = await fetch('/api/owner/yards', {
            method: 'POST',
            headers: {
              'Authorization': `Bearer ${token}`
              // KHÔNG set 'Content-Type': 'application/json' để trình duyệt tự động nhận diện boundary của multipart
            },
            body: formData
          });
          const result = await res.json();

          if (res.ok && result.success) {
            alert(result.message);
            window.location.href = '/owner';
          } else {
            alert(result.error || 'Tạo sân thất bại!');
          }
        } catch (e) {
          console.error(e);
          alert('Lỗi kết nối đến máy chủ!');
        }
      }