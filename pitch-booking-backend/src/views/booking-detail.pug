doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Chi tiết sân - #{yard.name}
    script(src="https://cdn.tailwindcss.com")
    link(href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet")
  body.bg-gray-50

    main(class="max-w-6xl mx-auto px-4 py-10")
      a(href="/" class="text-xs font-bold text-emerald-600 hover:text-emerald-700 flex items-center gap-1 mb-6 no-underline")
        i(class="fas fa-arrow-left")
        | Quay lại trang chủ

      div(class="grid grid-cols-1 lg:grid-cols-3 gap-8")
        
        //- CỘT TRÁI: Ảnh sân & Thông tin bảng giá
        div(class="lg:col-span-2 space-y-4")
          div(class="rounded-3xl overflow-hidden shadow-md h-80 bg-gray-100")
            img#mainImage(src=yard.image || yard.imageUrl || "https://images.unsplash.com/photo-1508098682722-e99c43a406b2?q=80&w=800&auto=format&fit=crop", alt=yard.name class="w-full h-full object-cover")

          //- Ảnh phụ
          if yard.subImages && yard.subImages.length > 0
            div
              h3(class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-2") Hình ảnh thực tế khác
              div(class="grid grid-cols-4 gap-3")
                div(class="rounded-xl overflow-hidden h-20 cursor-pointer border-2 border-emerald-500 shadow-sm transition-all" onclick=`changeMainImage('${yard.image || yard.imageUrl}')`)
                  img(src=yard.image || yard.imageUrl, class="w-full h-full object-cover")
                each subImg in yard.subImages
                  div(class="rounded-xl overflow-hidden h-20 cursor-pointer border-2 border-transparent hover:border-emerald-400 shadow-sm transition-all" onclick=`changeMainImage('${subImg}')`)
                    img(src=subImg, class="w-full h-full object-cover")

          //- Chi tiết thông tin sân
          div(class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm mt-6")
            span(class="bg-emerald-50 text-emerald-600 text-xs font-bold px-3 py-1 rounded-full uppercase")= yard.type || yard.sportType || 'Thể thao'
            h1(class="text-2xl font-black text-gray-900 mt-2 mb-2")= yard.name
            p(class="text-gray-500 text-sm flex items-center gap-2 mb-4")
              i(class="fas fa-map-marker-alt text-emerald-500")
              span= yard.location || yard.address || 'Đang cập nhật'
            hr(class="border-gray-100 my-4")
            
            h4(class="font-bold text-sm text-gray-800 mb-2") Bảng giá dịch vụ
            div(class="grid grid-cols-2 gap-4")
              div(class="bg-emerald-50/50 p-4 rounded-2xl border border-emerald-100")
                span(class="text-xs text-gray-500 block uppercase font-bold") Ca Sáng (05:00 - 18:00)
                span(class="text-emerald-600 text-lg font-black")= yard.priceMorning ? (yard.priceMorning/2).toLocaleString() + 'đ / 30 phút' : 'Liên hệ'
              div(class="bg-amber-50/50 p-4 rounded-2xl border border-amber-100")
                span(class="text-xs text-gray-500 block uppercase font-bold") Ca Tối (18:00 - 05:00)
                span(class="text-amber-600 text-lg font-black")= yard.priceEvening ? (yard.priceEvening/2).toLocaleString() + 'đ / 30 phút' : 'Liên hệ'

        //- CỘT PHẢI: Thông tin chủ sân & Lưới chọn khung giờ đặt sân
        div(class="lg:col-span-1 space-y-6")
          
          //- KHUNG THÔNG TIN CHỦ SÂN
          div(class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm")
            h4(class="font-bold text-sm text-gray-800 mb-3 flex items-center gap-2")
              i(class="fas fa-user-shield text-emerald-600")
              | Thông tin chủ sân
            div(class="space-y-2 text-xs text-gray-600")
              div(class="flex items-center justify-between")
                span(class="text-gray-400 font-medium") Người quản lý:
                span(class="font-bold text-gray-900")= yard.ownerName || (yard.owner && yard.owner.name) || 'Ban quản lý sân'
              div(class="flex items-center justify-between")
                span(class="text-gray-400 font-medium") Số điện thoại:
                a(href=`tel:${yard.ownerPhone || (yard.owner && yard.owner.phone) || yard.phone || '0900000000'}` class="font-black text-emerald-600 hover:underline flex items-center gap-1")
                  i(class="fas fa-phone-alt text-[10px]")
                  = yard.ownerPhone || (yard.owner && yard.owner.phone) || yard.phone || 'Đang cập nhật'

          //- KHUNG CHỌN LỊCH ĐẶT SÂN
          div(class="bg-white p-6 rounded-3xl border border-gray-100 shadow-xl")
            h3(class="font-black text-lg text-gray-900 mb-4 flex items-center gap-2")
              i(class="fas fa-calendar-alt text-emerald-600")
              | Chọn Lịch Đặt Sân
            
            form#bookingForm(class="space-y-4")
              input(type="hidden" id="yardId" value=yard._id)
              
              div
                label(class="block text-xs font-bold text-gray-500 uppercase mb-1") 1. Chọn ngày đá
                input(type="date" id="bookingDate" required class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500")

              div
                div(class="flex items-center justify-between mb-2")
                  label(class="block text-xs font-bold text-gray-500 uppercase") 2. Chọn khung giờ (Mỗi ô 30 phút)
                  span(class="text-[10px] text-gray-400") Bấm để chọn/bỏ chọn
                
                //- Chú thích trạng thái ô
                div(class="flex items-center gap-3 text-[11px] text-gray-500 mb-2")
                  span(class="flex items-center gap-1") <span class="w-3 h-3 bg-white border border-gray-200 rounded"></span> Trống
                  span(class="flex items-center gap-1") <span class="w-3 h-3 bg-emerald-500 rounded"></span> Đang chọn
                  span(class="flex items-center gap-1") <span class="w-3 h-3 bg-gray-200 rounded"></span> Đã đặt

                //- Lưới slot giờ 30 phút
                div#slotsContainer(class="grid grid-cols-3 gap-2 max-h-56 overflow-y-auto p-1 border border-gray-100 rounded-2xl bg-gray-50/50")
                  p(class="col-span-3 text-center text-xs text-gray-400 py-4") Vui lòng chọn ngày trước để xem lịch trống.

              //- Thông tin tổng kết tạm tính
              div(class="bg-emerald-50/60 p-4 rounded-2xl border border-emerald-100 space-y-1")
                div(class="flex justify-between text-xs text-gray-600")
                  <span>Số ô đã chọn:</span>
                  span(id="selectedCount" class="font-bold text-gray-900") 0 ô (0 phút)
                div(class="flex justify-between text-sm text-gray-900 font-black")
                  <span>Tổng tiền tạm tính:</span>
                  span(id="totalPrice" class="text-emerald-600") 0đ

              div(id="alertBox" class="hidden p-3 rounded-xl text-xs font-medium")

              button(type="submit" class="w-full py-3.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl shadow-lg shadow-emerald-600/30 transition-all flex items-center justify-center gap-2")
                i(class="fas fa-check-circle")
                | Xác Nhận Đặt Sân

    script.
      const priceMorning = Number("#{yard.priceMorning || 0}");
      const priceEvening = Number("#{yard.priceEvening || 0}");
      let selectedSlots = [];

      function changeMainImage(url) {
        document.getElementById('mainImage').src = url;
      }

      // Đặt mặc định ngày hôm nay cho ô chọn ngày
      const todayStr = new Date().toISOString().split('T')[0];
      const dateInput = document.getElementById('bookingDate');
      dateInput.value = todayStr;
      dateInput.min = todayStr;

      // Sinh toàn bộ các ô 30 phút từ 05:00 đến 05:00 sáng hôm sau
      function generateAllTimeSlots() {
        const slots = [];
        for (let h = 5; h < 29; h++) { // 29 tương đương 05:00 sáng hôm sau (24 + 5)
          const realH = h % 24;
          const hourStr = String(realH).padStart(2, '0');
          slots.push(`${hourStr}:00`);
          slots.push(`${hourStr}:30`);
        }
        return slots;
      }

      // Tải trạng thái lịch trống của sân khi thay đổi ngày
      async function fetchSlotsStatus() {
        const yardId = document.getElementById('yardId').value;
        const date = dateInput.value;
        if (!date) return;

        try {
          const res = await fetch(`/api/bookings/slots?yardId=${yardId}&date=${date}`);
          const data = await res.json();
          const bookedSlots = data.bookedSlots || [];

          renderSlotsGrid(bookedSlots);
        } catch (err) {
          console.error("Lỗi tải lịch sân:", err);
        }
      }

      function renderSlotsGrid(bookedSlots) {
        const container = document.getElementById('slotsContainer');
        const allSlots = generateAllTimeSlots();
        selectedSlots = []; // Reset lựa chọn khi đổi ngày
        updateSummary();

        container.innerHTML = allSlots.map(slot => {
          const isBooked = bookedSlots.includes(slot);
          if (isBooked) {
            return `<div class="bg-gray-200 text-gray-400 text-xs font-bold py-2 text-center rounded-xl cursor-not-allowed line-through" title="Đã có người đặt">${slot}</div>`;
          } else {
            return `<div onclick="toggleSlot(this, '${slot}')" data-slot="${slot}" class="slot-item bg-white border border-gray-200 text-gray-700 text-xs font-bold py-2 text-center rounded-xl cursor-pointer hover:border-emerald-500 transition-all">${slot}</div>`;
          }
        }).join('');
      }

      function toggleSlot(element, slot) {
        if (element.classList.contains('bg-emerald-500')) {
          // Bỏ chọn
          element.classList.remove('bg-emerald-500', 'text-white', 'border-emerald-500');
          element.classList.add('bg-white', 'text-gray-700', 'border-gray-200');
          selectedSlots = selectedSlots.filter(s => s !== slot);
        } else {
          // Chọn
          element.classList.remove('bg-white', 'text-gray-700', 'border-gray-200');
          element.classList.add('bg-emerald-500', 'text-white', 'border-emerald-500');
          selectedSlots.push(slot);
        }
        updateSummary();
      }

      function updateSummary() {
        document.getElementById('selectedCount').innerText = `${selectedSlots.length} ô (${selectedSlots.length * 30} phút)`;
        
        let totalPrice = 0;
        const blockMorningRate = priceMorning / 2;
        const blockEveningRate = priceEvening / 2;

        selectedSlots.forEach(slot => {
          const [h] = slot.split(':').map(Number);
          if (h >= 5 && h < 18) {
            totalPrice += blockMorningRate;
          } else {
            totalPrice += blockEveningRate;
          }
        });

        document.getElementById('totalPrice').innerText = totalPrice.toLocaleString() + 'đ';
      }

      // Lắng nghe sự kiện thay đổi ngày
      dateInput.addEventListener('change', fetchSlotsStatus);

      // Gọi lần đầu khi load trang
      fetchSlotsStatus();

      // Xử lý submit đặt sân
      document.getElementById('bookingForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const token = localStorage.getItem('token');
        const alertBox = document.getElementById('alertBox');

        if (!token) {
          alert('Vui lòng đăng nhập tài khoản trước khi tiến hành đặt sân!');
          window.location.href = '/auth?mode=login';
          return;
        }

        if (selectedSlots.length === 0) {
          alertBox.classList.remove('hidden');
          alertBox.className = 'p-3 rounded-xl text-xs font-medium bg-rose-50 text-rose-600 border border-rose-200';
          alertBox.innerText = 'Vui lòng chọn ít nhất một khung giờ trên lưới!';
          return;
        }

        const yardId = document.getElementById('yardId').value;
        const date = dateInput.value;

        try {
          const response = await fetch('/api/bookings', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${token}`
            },
            body: JSON.stringify({ yardId, date, slots: selectedSlots })
          });

          const result = await response.json();

          alertBox.classList.remove('hidden');
          if (response.ok && result.success) {
            alertBox.className = 'p-3 rounded-xl text-xs font-medium bg-emerald-50 text-emerald-600 border border-emerald-200';
            alertBox.innerText = result.message;
            setTimeout(() => {
              window.location.href = '/customer/my-bookings';
            }, 1500);
          } else {
            alertBox.className = 'p-3 rounded-xl text-xs font-medium bg-rose-50 text-rose-600 border border-rose-200';
            alertBox.innerText = result.error || 'Có lỗi xảy ra!';
            fetchSlotsStatus();
          }
        } catch (error) {
          console.error(error);
          alertBox.classList.remove('hidden');
          alertBox.className = 'p-3 rounded-xl text-xs font-medium bg-rose-50 text-rose-600 border border-rose-200';
          alertBox.innerText = 'Không thể kết nối đến máy chủ!';
        }
      });