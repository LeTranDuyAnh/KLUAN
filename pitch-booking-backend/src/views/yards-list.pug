doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Phân Loại Sân Thể Thao - Hệ Thống Đặt Sân
    script(src="https://cdn.tailwindcss.com")
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet")
    link(href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet")
  body.bg-gray-50 

    //- 1. Header dùng chung
    include header

    //- 2. THANH TÌM KIẾM & BỘ LỌC NÂNG CAO
    section(class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-6 mb-10")
      div(class="bg-white rounded-2xl shadow-xl p-6 border border-gray-100")
        form(action="/booking" method="GET" class="space-y-4")
          div(class="grid grid-cols-1 md:grid-cols-3 gap-4")
            
            //- Ô tìm kiếm tên sân / khu vực
            div(class="relative")
              label(class="block text-xs font-bold text-gray-500 uppercase mb-1") Tìm kiếm sân
              div(class="relative flex items-center")
                i(class="fas fa-search absolute left-3.5 text-gray-400")
                input(type="text" name="keyword" placeholder="Nhập tên sân, khu vực, địa điểm..." class="w-full pl-10 pr-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:bg-white transition-all")

            //- Lọc theo loại sân
            div(class="relative")
              label(class="block text-xs font-bold text-gray-500 uppercase mb-1") Loại môn thể thao
              select(name="sport" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:bg-white transition-all cursor-pointer")
                option(value="") Tất cả các môn
                option(value="football") Bóng đá
                option(value="basketball") Bóng rổ
                option(value="tennis") Tennis
                option(value="pickleball") Pickleball
                option(value="badminton") Cầu lông

            //- Nút tìm kiếm
            div(class="flex items-end")
              button(type="submit" class="w-full py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl shadow-lg shadow-emerald-600/30 transition-all flex items-center justify-center gap-2")
                i(class="fas fa-filter")
                | Lọc Kết Quả

          //- Bộ lọc nhanh dạng các nút Tag
          div(class="flex flex-wrap items-center gap-2 pt-3 border-t border-gray-100 mt-4")
            span(class="text-xs font-bold text-gray-400 uppercase mr-2") Lọc nhanh:
            a(href="/booking" class="px-3.5 py-1.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-600 hover:bg-emerald-600 hover:text-white transition-all no-underline") Tất cả
            a(href="/booking?sport=football" class="px-3.5 py-1.5 rounded-full text-xs font-semibold bg-gray-100 text-gray-600 hover:bg-emerald-600 hover:text-white transition-all no-underline") ⚽ Bóng đá
            a(href="/booking?sport=basketball" class="px-3.5 py-1.5 rounded-full text-xs font-semibold bg-gray-100 text-gray-600 hover:bg-emerald-600 hover:text-white transition-all no-underline") 🏀 Bóng rổ
            a(href="/booking?sport=tennis" class="px-3.5 py-1.5 rounded-full text-xs font-semibold bg-gray-100 text-gray-600 hover:bg-emerald-600 hover:text-white transition-all no-underline") 🎾 Tennis
            a(href="/booking?sport=pickleball" class="px-3.5 py-1.5 rounded-full text-xs font-semibold bg-gray-100 text-gray-600 hover:bg-emerald-600 hover:text-white transition-all no-underline") 🏓 Pickleball
            a(href="/booking?sport=badminton" class="px-3.5 py-1.5 rounded-full text-xs font-semibold bg-gray-100 text-gray-600 hover:bg-emerald-600 hover:text-white transition-all no-underline") 🏸 Cầu lông

    //- 3. PHẦN HIỂN THỊ DANH SÁCH SÂN CHIA THEO TỪNG LOẠI (GROUP BY SPORT)
    section(class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-20")
      div(class="flex justify-between items-end mb-8")
        div
          span(class="text-emerald-600 font-bold text-xs uppercase tracking-wider bg-emerald-50 px-3 py-1 rounded-full") Phân chia theo môn
          h1(class="text-2xl sm:text-3xl font-black text-gray-900 mt-2") Hệ Thống Sân Theo Danh Mục
        span(class="text-xs text-gray-400 font-medium") Tự động nhóm theo loại thể thao

      //- Container hiển thị các nhóm sân được chia loại
      div#categorizedYardsContainer(class="space-y-12")
        div(class="text-center py-12 text-gray-400")
          i(class="fas fa-spinner fa-spin text-2xl text-emerald-600 mb-2")
          p(class="text-sm") Đang phân loại và tải danh sách sân...

    //- 4. Footer dùng chung
    include footer

    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js")
    
    script.
      document.addEventListener('DOMContentLoaded', async () => {
        const container = document.getElementById('categorizedYardsContainer');
        
        // Cấu hình chuẩn tên hiển thị và Icon tương ứng cho từng môn
        const sportConfig = {
          'football': { name: 'Sân Bóng Đá', icon: 'fas fa-futbol text-emerald-600' },
          'basketball': { name: 'Sân Bóng Rổ', icon: 'fas fa-basketball-ball text-orange-600' },
          'tennis': { name: 'Sân Tennis', icon: 'fas fa-baseball-ball text-yellow-600' },
          'pickleball': { name: 'Sân Pickleball', icon: 'fas fa-table-tennis text-teal-600' },
          'badminton': { name: 'Sân Cầu Lông', icon: 'fas fa-feather-alt text-sky-600' },
          'other': { name: 'Các Môn Thể Thao Khác', icon: 'fas fa-medal text-purple-600' }
        };

        // Hàm hỗ trợ ánh xạ từ tiếng Việt hoặc từ khóa bất kỳ sang mã chuẩn
        function normalizeSportType(rawType) {
          if (!rawType) return 'other';
          const t = rawType.toLowerCase().trim();
          
          if (t.includes('bóng đá') || t.includes('football') || t.includes('da') || t.includes('soccer')) return 'football';
          if (t.includes('bóng rổ') || t.includes('basketball') || t.includes('ro')) return 'basketball';
          if (t.includes('tennis') || t.includes('quần vợt')) return 'tennis';
          if (t.includes('pickleball')) return 'pickleball';
          if (t.includes('cầu lông') || t.includes('badminton') || t.includes('long')) return 'badminton';
          
          return sportConfig[t] ? t : 'other';
        }

        try {
          const urlParams = new URLSearchParams(window.location.search);
          const keyword = urlParams.get('keyword') || '';
          const selectedSport = urlParams.get('sport') || '';

          const response = await fetch('/api/yards'); 
          const data = await response.json();
          let yards = Array.isArray(data) ? data : (data.yards || data.data || []);

          // Lọc theo từ khóa tìm kiếm (nếu có)
          if (keyword) {
            yards = yards.filter(y => 
              (y.name && y.name.toLowerCase().includes(keyword.toLowerCase())) || 
              (y.location && y.location.toLowerCase().includes(keyword.toLowerCase())) ||
              (y.address && y.address.toLowerCase().includes(keyword.toLowerCase()))
            );
          }
          // Lọc theo loại môn nếu người dùng chọn trên select box hoặc tag
          if (selectedSport) {
            yards = yards.filter(y => {
              const currentType = normalizeSportType(y.type || y.sportType || y.sport);
              return currentType === selectedSport.toLowerCase().trim();
            });
          }

          if (yards.length === 0) {
            container.innerHTML = `
              <div class="text-center py-16 bg-white rounded-3xl border border-gray-100 shadow-sm">
                <i class="fas fa-box-open text-4xl mb-3 text-gray-300"></i>
                <p class="text-gray-500 text-sm font-medium">Không tìm thấy sân thể thao phù hợp với yêu cầu của bạn.</p>
                <a href="/booking" class="inline-block mt-4 px-4 py-2 bg-emerald-600 text-white text-xs font-bold rounded-xl no-underline">Xem tất cả sân</a>
              </div>`;
            return;
          }

          // Gom nhóm sân theo loại đã được chuẩn hóa thông minh
          const grouped = {};
          yards.forEach(yard => {
            const rawType = yard.type || yard.sportType || yard.sport;
            const sportKey = normalizeSportType(rawType);
            
            if (!grouped[sportKey]) {
              grouped[sportKey] = [];
            }
            grouped[sportKey].push(yard);
          });

          // Render ra giao diện theo từng block phân loại
          let htmlOutput = '';
          for (const [sportKey, listYards] of Object.entries(grouped)) {
            const config = sportConfig[sportKey] || { name: 'Thể Thao Khác', icon: 'fas fa-trophy text-emerald-600' };
            
            htmlOutput += `
              <div class="category-section bg-white p-6 sm:p-8 rounded-3xl border border-gray-100 shadow-sm">
                <div class="flex items-center justify-between mb-6 pb-4 border-b border-gray-100">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-2xl bg-gray-50 flex items-center justify-center text-lg shadow-sm">
                      <i class="${config.icon}"></i>
                    </div>
                    <div>
                      <h2 class="font-black text-xl text-gray-900">${config.name}</h2>
                      <span class="text-xs text-gray-400 font-medium">${listYards.length} sân sẵn sàng phục vụ</span>
                    </div>
                  </div>
                  <span class="text-xs font-bold text-emerald-600 bg-emerald-50 px-3 py-1.5 rounded-xl">Đang mở cửa</span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                  ${listYards.map(yard => `
                    <div class="bg-white p-4 rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg hover:border-emerald-200 transition-all duration-300 flex flex-col justify-between h-full group">
                      <div>
                        <div class="relative h-44 overflow-hidden rounded-xl mb-3 bg-gray-100">
                          <img src="${yard.image || yard.imageUrl || 'https://images.unsplash.com/photo-1508098682722-e99c43a406b2?q=80&w=500&auto=format&fit=crop'}" alt="${yard.name || 'Sân thể thao'}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                          <span class="absolute top-2.5 left-2.5 bg-emerald-600 text-white text-[10px] font-bold px-2.5 py-1 rounded-lg uppercase shadow-md">${config.name}</span>
                        </div>
                        <h4 class="font-bold text-sm text-gray-900 mb-1 line-clamp-1 group-hover:text-emerald-600 transition-colors" title="${yard.name}">${yard.name}</h4>
                        <p class="text-gray-500 text-[11px] mb-3 flex items-center gap-1.5 line-clamp-1" title="${yard.location || yard.address}">
                          <i class="fas fa-map-marker-alt text-emerald-500 flex-shrink-0"></i>
                          <span>${yard.location || yard.address || 'Đang cập nhật'}</span>
                        </p>
                      </div>

                      <div class="pt-3 border-t border-gray-100 mt-auto">
                        <div class="grid grid-cols-2 gap-2 mb-3 bg-gray-50 p-2 rounded-xl text-center">
                          <div>
                            <span class="block text-[9px] text-gray-400 font-bold uppercase">Sáng (30p)</span>
                            <span class="text-emerald-600 font-black text-xs">${yard.priceMorning ? (yard.priceMorning/2).toLocaleString() + 'đ' : 'Liên hệ'}</span>
                          </div>
                          <div class="border-l border-gray-200">
                            <span class="block text-[9px] text-gray-400 font-bold uppercase">Tối (30p)</span>
                            <span class="text-amber-600 font-black text-xs">${yard.priceEvening ? (yard.priceEvening/2).toLocaleString() + 'đ' : 'Liên hệ'}</span>
                          </div>
                        </div>

                        <div class="grid grid-cols-2 gap-1.5">
                          <a href="/booking/${yard._id || yard.id}" class="py-2 px-2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold text-[11px] rounded-xl transition-all no-underline text-center flex items-center justify-center gap-1">
                            <i class="fas fa-eye text-[10px]"></i> Chi tiết
                          </a>
                          <a href="/booking/${yard._id || yard.id}" class="py-2 px-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-[11px] rounded-xl transition-all no-underline text-center shadow-sm flex items-center justify-center gap-1">
                            <i class="fas fa-calendar-check text-[10px]"></i> Đặt sân
                          </a>
                        </div>
                      </div>
                    </div>
                  `).join('')}
                </div>
              </div>
            `;
          }

          container.innerHTML = htmlOutput;

        } catch (error) {
          console.error('Lỗi khi phân loại dữ liệu sân:', error);
          container.innerHTML = `
            <div class="text-center py-8 text-red-500 text-xs">
              <i class="fas fa-exclamation-triangle mr-1"></i> Không thể phân loại và tải danh sách sân từ cơ sở dữ liệu.
            </div>`;
        }
      });