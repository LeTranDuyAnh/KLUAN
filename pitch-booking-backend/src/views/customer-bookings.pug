doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Lịch sử đặt sân của tôi
    script(src="https://cdn.tailwindcss.com")
    link(href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet")
  body.bg-gray-50

    main(class="max-w-5xl mx-auto px-4 py-10")
      div(class="flex justify-between items-center mb-6")
        div
          a(href="/" class="text-xs font-bold text-emerald-600 hover:text-emerald-700 flex items-center gap-1 mb-2 no-underline")
            i(class="fas fa-arrow-left")
            | Về trang chủ
          h1(class="text-2xl font-black text-gray-900") Lịch sử đặt sân của bạn

      div#bookingListContainer(class="space-y-4")
        div(class="text-center py-12 text-gray-400")
          i(class="fas fa-spinner fa-spin text-2xl text-emerald-600 mb-2")
          p(class="text-sm") Đang tải lịch sử đặt sân...

    script.
      document.addEventListener('DOMContentLoaded', async () => {
        const token = localStorage.getItem('token');
        if (!token) {
          alert('Vui lòng đăng nhập để xem lịch sử đặt sân!');
          window.location.href = '/auth?mode=login';
          return;
        }

        const container = document.getElementById('bookingListContainer');

        try {
          const res = await fetch('/api/customer/bookings', {
            headers: { 'Authorization': `Bearer ${token}` }
          });
          const data = await res.json();

          if (!data.success || !data.bookings || data.bookings.length === 0) {
            container.innerHTML = `
              <div class="bg-white rounded-2xl p-12 text-center border border-gray-100 shadow-sm">
                <i class="fas fa-calendar-times text-4xl text-gray-300 mb-3"></i>
                <p class="text-gray-500 text-sm font-medium">Bạn chưa có lịch đặt sân nào.</p>
                <a href="/" class="inline-block mt-4 px-4 py-2 bg-emerald-600 text-white text-xs font-bold rounded-xl shadow-md no-underline">Đặt sân ngay</a>
              </div>`;
            return;
          }

          container.innerHTML = data.bookings.map(item => {
            const yard = item.yard || {};
            let statusBadge = '';
            if (item.status === 'pending') {
              statusBadge = '<span class="bg-amber-50 text-amber-600 border border-amber-200 px-3 py-1 rounded-full text-[10px] font-bold uppercase">Đang chờ duyệt</span>';
            } else if (item.status === 'confirmed') {
              statusBadge = '<span class="bg-emerald-50 text-emerald-600 border border-emerald-200 px-3 py-1 rounded-full text-[10px] font-bold uppercase">Đã xác nhận</span>';
            } else {
              statusBadge = '<span class="bg-rose-50 text-rose-600 border border-rose-200 px-3 py-1 rounded-full text-[10px] font-bold uppercase">Đã hủy</span>';
            }

            return `
              <div class="bg-white p-5 rounded-2xl border border-gray-100 shadow-sm flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
                <div class="flex items-center gap-4">
                  <img src="${yard.image || yard.imageUrl || 'https://images.unsplash.com/photo-1508098682722-e99c43a406b2?q=80&w=300&auto=format&fit=crop'}" class="w-20 h-20 rounded-xl object-cover flex-shrink-0" alt="">
                  <div>
                    <div class="flex items-center gap-2 mb-1">
                      <span class="text-[10px] font-bold bg-gray-100 text-gray-600 px-2 py-0.5 rounded uppercase">${yard.type || 'Thể thao'}</span>
                      ${statusBadge}
                    </div>
                    <h3 class="font-bold text-gray-900 text-base">${yard.name || 'Sân đã bị xóa'}</h3>
                    <p class="text-xs text-gray-500 mb-1"><i class="fas fa-map-marker-alt text-emerald-500 mr-1"></i> ${yard.location || yard.address || 'Đang cập nhật'}</p>
                    <p class="text-xs text-gray-600 font-semibold mt-1">
                        📅 Ngày đá: <span class="text-emerald-600">${item.date}</span> | ⏰ Giờ: <span class="text-gray-900">${item.startTime || '--:--'} - ${item.endTime || '--:--'}</span>
                    </p>
                  </div>
                </div>

                <div class="flex flex-col items-end justify-between w-full md:w-auto border-t md:border-t-0 pt-3 md:pt-0 border-gray-100">
                  <div class="text-right mb-2">
                    <span class="text-[10px] text-gray-400 block uppercase font-bold">Tổng tiền</span>
                    <span class="text-emerald-600 font-black text-sm">${item.totalPrice ? item.totalPrice.toLocaleString() + 'đ' : 'Liên hệ'}</span>
                  </div>
                  
                  ${item.status === 'pending' ? `
                    <button onclick="cancelBooking('${item._id}')" class="px-3 py-1.5 bg-rose-50 hover:bg-rose-600 text-rose-600 hover:text-white text-xs font-bold rounded-xl transition-all border border-rose-100">
                      Hủy lịch đặt
                    </button>
                  ` : ''}
                </div>
              </div>
            `;
          }).join('');

        } catch (err) {
          console.error(err);
          container.innerHTML = `<p class="text-center text-rose-500 text-xs">Không thể tải dữ liệu lịch sử đặt sân.</p>`;
        }
      });

      async function cancelBooking(id) {
        if (!confirm('Bạn có chắc chắn muốn hủy lịch đặt sân này không?')) return;
        
        const token = localStorage.getItem('token');
        try {
          const res = await fetch(`/api/customer/bookings/${id}/cancel`, {
            method: 'PATCH',
            headers: { 'Authorization': `Bearer ` + token }
          });
          const result = await res.json();
          if (res.ok && result.success) {
            alert(result.message);
            location.reload();
          } else {
            alert(result.error || 'Hủy lịch thất bại!');
          }
        } catch (e) {
          alert('Lỗi kết nối đến máy chủ!');
        }
      }