//- header.pug
header(class="bg-white shadow-md sticky top-0 z-50")
  div(class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8")
    div(class="flex items-center justify-between h-20")
      
      //- 1. BÊN TRÁI: LOGO THỂ THAO
      div(class="flex items-center gap-3")
        a(href="/" class="flex items-center gap-2 text-decoration-none group")
          div(class="w-11 h-11 rounded-xl bg-gradient-to-tr from-emerald-600 to-teal-400 flex items-center justify-center text-white shadow-lg shadow-emerald-500 group-hover:scale-105 transition-transform duration-300")
            i(class="fas fa-futbol text-xl animate-pulse")
          div(class="flex flex-col")
            span(class="font-black text-xl tracking-wider text-gray-900 uppercase") Sport#[span(class="text-emerald-600") Hub]
            span(class="text-[10px] font-semibold text-gray-400 tracking-widest uppercase -mt-1") Arena Booking

      //- 2. Ở GIỮA: CÁC TÍNH NĂNG ĐIỀU HƯỚNG
      nav(class="hidden md:flex items-center space-x-1 lg:space-x-2")
        a(href="/" class=`px-3.5 py-2 rounded-lg text-sm font-semibold transition-colors ${activePage === 'home' ? 'text-emerald-600 bg-emerald-50' : 'text-gray-600 hover:text-emerald-600 hover:bg-gray-50'}`)
          i(class="fas fa-home me-1.5")
          | Trang chủ
        a(href="/booking" class=`px-3.5 py-2 rounded-lg text-sm font-medium transition-colors ${activePage === 'booking' ? 'text-emerald-600 bg-emerald-50 font-semibold' : 'text-gray-600 hover:text-emerald-600 hover:bg-gray-50'}`)
          i(class="fas fa-calendar-alt me-1.5")
          | Trang đặt sân
        a(href="/vouchers" class=`px-3.5 py-2 rounded-lg text-sm font-medium transition-colors ${activePage === 'voucher' ? 'text-emerald-600 bg-emerald-50 font-semibold' : 'text-gray-600 hover:text-emerald-600 hover:bg-gray-50'}`)
          i(class="fas fa-ticket-alt me-1.5")
          | Voucher
        a(href="/about" class=`px-3.5 py-2 rounded-lg text-sm font-medium transition-colors ${activePage === 'about' ? 'text-emerald-600 bg-emerald-50 font-semibold' : 'text-gray-600 hover:text-emerald-600 hover:bg-gray-50'}`)
          i(class="fas fa-info-circle me-1.5")
          | Thông tin
        a(href="/map" class=`px-3.5 py-2 rounded-lg text-sm font-medium transition-colors ${activePage === 'map' ? 'text-emerald-600 bg-emerald-50 font-semibold' : 'text-gray-600 hover:text-emerald-600 hover:bg-gray-50'}`)
          i(class="fas fa-map-marked-alt me-1.5")
          | Bản đồ

      //- 3. BÊN PHẢI: KHU VỰC TÀI KHOẢN
      div(class="flex items-center")
        div#authContainer

  //- Menu Mobile
  div(class="md:hidden bg-white border-t border-gray-100 px-4 py-2 flex justify-around text-xs")
    a(href="/" class=`py-1 ${activePage === 'home' ? 'text-emerald-600 font-bold' : 'text-gray-600'}`)
      i(class="fas fa-home d-block text-center text-base mb-1")
      | Trang chủ
    a(href="/booking" class=`py-1 ${activePage === 'booking' ? 'text-emerald-600 font-bold' : 'text-gray-600'}`)
      i(class="fas fa-calendar-alt d-block text-center text-base mb-1")
      | Đặt sân
    a(href="/vouchers" class=`py-1 ${activePage === 'voucher' ? 'text-emerald-600 font-bold' : 'text-gray-600'}`)
      i(class="fas fa-ticket-alt d-block text-center text-base mb-1")
      | Voucher
    a(href="/about" class=`py-1 ${activePage === 'about' ? 'text-emerald-600 font-bold' : 'text-gray-600'}`)
      i(class="fas fa-info-circle d-block text-center text-base mb-1")
      | Thông tin
    a(href="/map" class=`py-1 ${activePage === 'map' ? 'text-emerald-600 font-bold' : 'text-gray-600'}`)
      i(class="fas fa-map-marked-alt d-block text-center text-base mb-1")
      | Bản đồ

//- 4. PHẦN BANNER SLIDER (5 Môn Thể Thao: Bóng đá, Bóng rổ, Tennis, Pickleball, Cầu lông)
div(class="relative w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-6")
  div(class="relative h-72 sm:h-96 rounded-2xl overflow-hidden shadow-lg bg-gray-900")
    
    //- Banner 1: Bóng đá
    div(class="banner-slide absolute inset-0 opacity-100 transition-opacity duration-1000 ease-in-out")
      img(src="https://images.unsplash.com/photo-1579952363873-27f3bade9f55?q=80&w=1600&auto=format&fit=crop" class="w-full h-full object-cover" alt="Sân Bóng Đá")
      div(class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent flex flex-col justify-end p-6 sm:p-10")
        span(class="bg-emerald-500 text-white text-xs font-bold px-3 py-1 rounded-full w-max mb-2") BÓNG ĐÁ
        h2(class="text-white text-2xl sm:text-4xl font-black tracking-tight") Sân Cỏ Nhân Tạo Chất Lượng Cao
        p(class="text-gray-200 text-sm sm:text-base mt-1") Đặt sân nhanh chóng, hệ thống chiếu sáng chuẩn thi đấu quốc tế.

    //- Banner 2: Bóng rổ
    div(class="banner-slide absolute inset-0 opacity-0 transition-opacity duration-1000 ease-in-out")
      img(src="https://images.unsplash.com/photo-1546519638-68e109498ffc?q=80&w=1600&auto=format&fit=crop" class="w-full h-full object-cover" alt="Sân Bóng Rổ")
      div(class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent flex flex-col justify-end p-6 sm:p-10")
        span(class="bg-orange-500 text-white text-xs font-bold px-3 py-1 rounded-full w-max mb-2") BÓNG RỔ
        h2(class="text-white text-2xl sm:text-4xl font-black tracking-tight") Sân Bóng Rổ Trong Nhà & Ngoài Trời
        p(class="text-gray-200 text-sm sm:text-base mt-1") Trải nghiệm không gian chuyên nghiệp, mặt sàn chống trượt cao cấp.

    //- Banner 3: Tennis
    div(class="banner-slide absolute inset-0 opacity-0 transition-opacity duration-1000 ease-in-out")
      img(src="https://images.unsplash.com/photo-1595435934249-5df7ed86e1c0?q=80&w=1600&auto=format&fit=crop" class="w-full h-full object-cover" alt="Sân Tennis")
      div(class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent flex flex-col justify-end p-6 sm:p-10")
        span(class="bg-blue-600 text-white text-xs font-bold px-3 py-1 rounded-full w-max mb-2") TENNIS
        h2(class="text-white text-2xl sm:text-4xl font-black tracking-tight") Sân Quần Vợt Tiêu Chuẩn Thi Đấu
        p(class="text-gray-200 text-sm sm:text-base mt-1") Không gian thoáng đãng, mặt sân cứng đạt chuẩn quốc tế cho mọi trận đấu.

    //- Banner 4: Pickleball (Đã thay link mới trực tiếp)
    div(class="banner-slide absolute inset-0 opacity-0 transition-opacity duration-1000 ease-in-out")
      img(src="https://images.unsplash.com/photo-1534438327276-14e5300c3a48?q=80&w=1600&auto=format&fit=crop" class="w-full h-full object-cover" alt="Sân Pickleball")
      div(class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent flex flex-col justify-end p-6 sm:p-10")
        span(class="bg-purple-600 text-white text-xs font-bold px-3 py-1 rounded-full w-max mb-2") PICKLEBALL
        h2(class="text-white text-2xl sm:text-4xl font-black tracking-tight") Cụm Sân Pickleball Hot Nhất Hiện Nay
        p(class="text-gray-200 text-sm sm:text-base mt-1") Thỏa sức đam mê bộ môn thể thao xu hướng với trang thiết bị hiện đại.

    //- Banner 5: Cầu lông (Đã thay link mới trực tiếp)
    div(class="banner-slide absolute inset-0 opacity-0 transition-opacity duration-1000 ease-in-out")
      img(src="https://images.unsplash.com/photo-1587280501635-68a0e82cd5ff?q=80&w=1600&auto=format&fit=crop" class="w-full h-full object-cover" alt="Sân Cầu Lông")
      div(class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent flex flex-col justify-end p-6 sm:p-10")
        span(class="bg-rose-500 text-white text-xs font-bold px-3 py-1 rounded-full w-max mb-2") CẦU LÔNG
        h2(class="text-white text-2xl sm:text-4xl font-black tracking-tight") Hệ Thống Sân Cầu Lông Thảm Chuyên Dụng
        p(class="text-gray-200 text-sm sm:text-base mt-1") Ánh sáng chống lóa, hệ thống thông gió mát mẻ, dịch vụ tiện ích đầy đủ.

    //- Nút điều hướng mũi tên (Trái / Phải)
    button(onclick="changeSlide(-1)" class="absolute left-4 top-1/2 -translate-y-1/2 bg-black/40 hover:bg-black/70 text-white w-10 h-10 rounded-full flex items-center justify-center transition-all")
      i(class="fas fa-chevron-left")
    button(onclick="changeSlide(1)" class="absolute right-4 top-1/2 -translate-y-1/2 bg-black/40 hover:bg-black/70 text-white w-10 h-10 rounded-full flex items-center justify-center transition-all")
      i(class="fas fa-chevron-right")

    //- 5 Chấm tròn chỉ số slide (Dots)
    div(class="absolute bottom-4 right-6 flex space-x-2")
      span(class="dot w-3 h-3 rounded-full bg-white cursor-pointer opacity-100" onclick="currentSlide(0)")
      span(class="dot w-3 h-3 rounded-full bg-white/50 cursor-pointer opacity-50" onclick="currentSlide(1)")
      span(class="dot w-3 h-3 rounded-full bg-white/50 cursor-pointer opacity-50" onclick="currentSlide(2)")
      span(class="dot w-3 h-3 rounded-full bg-white/50 cursor-pointer opacity-50" onclick="currentSlide(3)")
      span(class="dot w-3 h-3 rounded-full bg-white/50 cursor-pointer opacity-50" onclick="currentSlide(4)")

script.
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Logic xử lý hiển thị trạng thái Tài khoản / Auth trên Header
    const token = localStorage.getItem('token');
    const user = JSON.parse(localStorage.getItem('user') || '{}');
    const authContainer = document.getElementById('authContainer');

    if (token && user && (user.name || user.username)) {
      const displayName = user.name || user.username;
      const roleBadge = user.role === 'owner' ? '<span class="badge bg-warning text-dark ms-1" style="font-size: 10px;">Chủ sân</span>' : '';

      authContainer.innerHTML = `
        <div class="dropdown">
          <button class="btn btn-light border border-gray-200 dropdown-toggle d-flex align-items-center gap-2 rounded-pill px-3.5 py-1.5 shadow-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <div class="w-8 h-8 rounded-circle bg-emerald-600 text-white d-flex align-items-center justify-content-center fw-bold text-sm">
              ${displayName.charAt(0).toUpperCase()}
            </div>
            <span class="fw-semibold text-gray-700 text-sm">${displayName}</span>
            ${roleBadge}
          </button>
          <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 py-2 mt-2 rounded-xl">
            <li><a class="dropdown-item py-2 px-3 text-sm" href="/profile"><i class="fas fa-user-circle me-2 text-emerald-600"></i>Hồ sơ cá nhân</a></li>
            <li><a class="dropdown-item py-2 px-3 text-sm" href="/customer/my-bookings"><i class="fas fa-clipboard-list me-2 text-emerald-600"></i>Sân đã đặt</a></li>
            ${user.role === 'owner' ? '<li><a class="dropdown-item py-2 px-3 text-sm" href="/owner"><i class="fas fa-store me-2 text-emerald-600"></i>Quản lý sân của tôi</a></li>' : ''}
            <li><hr class="dropdown-divider my-1"></li>
            <li><button class="dropdown-item py-2 px-3 text-sm text-danger fw-semibold" onclick="handleLogout()"><i class="fas fa-sign-out-alt me-2"></i>Đăng xuất</button></li>
          </ul>
        </div>
      `;
    } else {
      authContainer.innerHTML = `
        <div class="flex items-center gap-2">
          <a class="px-4 py-2 text-sm font-semibold text-emerald-600 hover:text-emerald-700 transition-colors text-decoration-none" href="/auth?mode=login">
            Đăng nhập
          </a>
          <a class="px-4 py-2 text-sm font-semibold text-white bg-emerald-600 hover:bg-emerald-700 rounded-xl shadow-md shadow-emerald-600/20 transition-all duration-200 text-decoration-none" href="/auth?mode=register">
            Đăng ký
          </a>
        </div>
      `;
    }
  });

  function handleLogout() {
    localStorage.removeItem('token');
    localStorage.removeItem('user');
    window.location.href = '/';
  }

  // 2. Logic xử lý Slider 5 Banner tự động chuyển sau mỗi 5 giây
  let slideIndex = 0;
  let slideInterval;
  const slides = document.querySelectorAll('.banner-slide');
  const dots = document.querySelectorAll('.dot');

  function showSlide(index) {
    if (slides.length === 0) return;
    if (index >= slides.length) slideIndex = 0;
    if (index < 0) slideIndex = slides.length - 1;

    slides.forEach((slide, i) => {
      slide.classList.remove('opacity-100');
      slide.classList.add('opacity-0');
      if (dots[i]) {
        dots[i].classList.remove('opacity-100', 'bg-white');
        dots[i].classList.add('opacity-50', 'bg-white/50');
      }
    });

    slides[slideIndex].classList.remove('opacity-0');
    slides[slideIndex].classList.add('opacity-100');
    if (dots[slideIndex]) {
      dots[slideIndex].classList.remove('opacity-50', 'bg-white/50');
      dots[slideIndex].classList.add('opacity-100', 'bg-white');
    }
  }

  function nextSlide() {
    slideIndex++;
    showSlide(slideIndex);
  }

  function changeSlide(n) {
    slideIndex += n;
    showSlide(slideIndex);
    resetTimer();
  }

  function currentSlide(n) {
    slideIndex = n;
    showSlide(slideIndex);
    resetTimer();
  }

  function resetTimer() {
    clearInterval(slideInterval);
    slideInterval = setInterval(nextSlide, 5000);
  }

  // Khởi chạy vòng lặp tự động chuyển slide sau 5s
  if (slides.length > 0) {
    slideInterval = setInterval(nextSlide, 5000);
  }